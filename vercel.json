{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": ".",
      "framework": "node",
      "entrypoint": "server.mjs",
      "functions": {
        "server.mjs": {
          "maxDuration": 60,
          "includeFiles": "{diligence.html,studio-runtime/**,api/**,lib/**,data/**}"
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
