# Public edition environment template. Placeholders only; never commit values.
AUTH_SECRET=
SITE_URL=http://localhost:3000
PORT=3000
# Optional: Census key for city evidence (https://api.census.gov/data/key_signup.html)
CENSUS_API_KEY=
# Optional: shared budget store for live inference on deployed hosts
REDIS_URL=
# Site Diligence Agent (Nebius x NVIDIA hackathon lane). Placeholders only.
# Live inference runs only when every one of these is set and the budget store
# (Redis on a deployed host) is reachable. Otherwise the agent reports why.
NEBIUS_API_KEY=
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b
DILIGENCE_LIVE_INFERENCE=0
AI_BUDGET_APPROVAL_REFERENCE=
AI_APPROVED_BUDGET_USD=
# Total ceiling across dates. Optional expiry, ISO timestamp with timezone.
AI_BUDGET_APPROVAL_EXPIRES_AT=
DILIGENCE_DAILY_BUDGET_USD=
DILIGENCE_PER_RUN_BUDGET_USD=0.25
DILIGENCE_MAX_CONCURRENT=3
DILIGENCE_GUEST_INFERENCE=0
# Local only. Refused on any production-like host.
DILIGENCE_FIXTURE_MODE=0

# Standalone managed accounts. Public project credentials only; no service-role key.
DILIGENCE_SUPABASE_URL=
DILIGENCE_SUPABASE_PUBLISHABLE_KEY=
DILIGENCE_EMAIL_AUTH_ENABLED=false
DILIGENCE_GOOGLE_AUTH_ENABLED=false
DILIGENCE_GITHUB_AUTH_ENABLED=false
